+        /// Whether a custom shader animates now: by configuration, focus
+        /// and (for `cursor`) how recently the cursor or the focus changed.
+        fn shaderAnimating(self: *const Self) bool {
+            if (!self.has_custom_shaders) return false;
+            const mode = self.config.custom_shader_animation;
+            const since: ?u64 = if (mode == .cursor) self.msSinceCursorChange() else null;
+            return shaderAnimates(mode, self.focused, since);
