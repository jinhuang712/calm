+        return self.rows + 6;
+    }
+
+    fn draw(self: TestOpenCode, stream: anytype, buf: []u8, first: usize, thumb: usize, glyph: []const u8) !void {
+        const spaces = " " ** (width + sidebar_width);
+        const all = spaces[0..self.cols()];
+        stream.nextSlice("\x1b[?2026h");
+        for (0..self.rows) |row| {
+            const line = if (first + row < test_opencode_lines.len) test_opencode_lines[first + row] else "";
+            stream.nextSlice(try std.fmt.bufPrint(
+                buf,
+                "\x1b[{};1H\x1b[48;2;10;10;10m{s}\x1b[{};3H{s}\x1b[{};38H\x1b[48;2;30;30;30m{s}\x1b[48;2;10;10;10m  ",
+                .{ row + 1, spaces[0..37], row + 1, line, row + 1, if (row == thumb) glyph else " " },
+            ));
+            if (self.sidebar) {
+                stream.nextSlice(spaces[0..sidebar_width]);
+                for (sidebar_lines) |side| {
+                    if (side.row != row) continue;
+                    stream.nextSlice(try std.fmt.bufPrint(buf, "\x1b[{};{}H{s}", .{ row + 1, width + 5, side.text }));
+                }
+            }
+            stream.nextSlice("\x1b[0m");
+        }
+        stream.nextSlice(try std.fmt.bufPrint(buf, "\x1b[{};1H\x1b[48;2;10;10;10m{s}\x1b[0m", .{ self.rows + 1, all }));
+        for (0..4, [_][]const u8{ "", "type here", "", "Build auto" }) |i, text| {
+            const row = self.rows + 2 + i;
+            stream.nextSlice(try std.fmt.bufPrint(
+                buf,
+                "\x1b[{};1H\x1b[48;2;20;20;20m┃{s}\x1b[{};4H{s}\x1b[0m",
+                .{ row, all[1..], row, text },
+            ));
+        }
+        stream.nextSlice(try std.fmt.bufPrint(
+            buf,
+            "\x1b[{};1H\x1b[48;2;10;10;10m{s}\x1b[{};3H~/project\x1b[{};25Hctrl+p commands\x1b[0m\x1b[?2026l",
+            .{ self.rows + 6, all, self.rows + 6, self.rows + 6 },
+        ));
+    }
+
+    /// The cells of two frames: the transcript from `first` with its thumb
+    /// on `thumb`, then from `then_first` with it on `then_thumb`.
+    fn frames(
+        self: TestOpenCode,
+        first: usize,
+        thumb: usize,
+        then_first: usize,
+        then_thumb: usize,
+        old: []u64,
+        new: []u64,
+    ) !void {
+        const alloc = std.testing.allocator;
+        var t = try terminal.Terminal.init(std.testing.io, alloc, .{
+            .cols = @intCast(self.cols()),
+            .rows = @intCast(self.screenRows()),
+        });
+        defer t.deinit(alloc);
+        var s = t.vtStream();
+        defer s.deinit();
+        var buf: [512]u8 = undefined;
+        var state: terminal.RenderState = .empty;
+        defer state.deinit(alloc);
+
+        s.nextSlice("\x1b[?1049h");
+        try self.draw(&s, &buf, first, thumb, "▄");
+        try state.update(alloc, &t);
+        testCellHashes(&state, self.cols(), old);
+        try self.draw(&s, &buf, then_first, then_thumb, self.then_glyph);
+        try state.update(alloc, &t);
+        testCellHashes(&state, self.cols(), new);
+    }
+};
