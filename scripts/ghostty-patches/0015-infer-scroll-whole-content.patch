+/// does OpenCode), which leaves the terminal no scroll to animate; comparing
+/// each row with the frame before finds the motion anyway (`inferRows`),
+/// less any still column at the sides (`movingColumns`). The rows are
+/// compared on their middle first, `still_edge_band` columns in from each
+/// side, so a scrollbar there can't hide their motion (its thumb made the
+/// rows beside it match nothing, and the first frames of a scroll, before
+/// the scrollbar was known, drew a row's new line while the rows above it
+/// still slid towards it), then on their whole width, for lines that differ
+/// only at the sides, and once the still columns are known, without them. `old` and `new` are the frames' cells (`cellHashes`),
+/// `keep` the columns of the last region found, and `scratch` room for two
+/// hashes per row.
+fn inferScroll(old: CellGrid, new: CellGrid, keep: ?ColumnSpan, scratch: []u64) ?terminal.Screen.RegionScroll {
+    const n = new.rows();
+    if (new.cols == 0 or old.cols != new.cols or old.cells.len != new.cells.len) return null;
+    if (scratch.len < 2 * n) return null;
+    const full: ColumnSpan = .{ .left = 0, .right = new.cols - 1 };
+    const middle: ColumnSpan = if (new.cols >= 4 * still_edge_band)
+        .{ .left = still_edge_band, .right = new.cols - 1 - still_edge_band }
+    else
+        full;
