+/// A region scroll draws its next frame once its content has moved this many
+/// pixels since the last one, and always the frame it comes to rest in. Its
+/// ease slows below a pixel a frame for the second half of its way, where a
+/// frame at every refresh drew the content less than a pixel from the last.
+const region_anim_step_px: f64 = 1;
+
+/// Seconds a region scroll animation with `shift` pixels left, easing with
+/// time constant `tau` seconds, takes to move `region_anim_step_px` more, or
+/// to come to rest (under half a pixel) if that is nearer. 0 once at rest.
+fn regionAnimStepSeconds(shift: f64, tau: f64) f64 {
+    const left = @abs(shift);
+    if (left < 0.5) return 0;
+    const next = @max(left - region_anim_step_px, 0.499);
+    return tau * @log(left / next);
 }
 
