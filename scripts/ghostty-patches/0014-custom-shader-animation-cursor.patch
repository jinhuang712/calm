 const log = std.log.scoped(.generic_renderer);
+
+/// How long `custom-shader-animation = cursor` animates after the cursor or
+/// the focus last changed. A cursor effect (a trail, a glide) is over well
+/// within it; after it a still terminal draws nothing.
+const cursor_animation_ms: u64 = 1000;
+
+/// Whether a custom shader animates now under `custom-shader-animation` =
+/// `mode`: `ms_since_cursor_change` is how long ago the cursor or the focus
+/// last changed, null before either has.
+fn shaderAnimates(
+    mode: configpkg.CustomShaderAnimation,
+    focused: bool,
+    ms_since_cursor_change: ?u64,
+) bool {
+    return switch (mode) {
+        .false => false,
+        .always => true,
+        .true => focused,
+        .cursor => focused and
+            (if (ms_since_cursor_change) |ms| ms < cursor_animation_ms else false),
+    };
+}
 
