+/// Whether column `x` is a bar down the reach of `rows`: one cell, a
+/// background with no text, in all its rows but two at most (a scrollbar's
+/// track, with the thumb), that the columns beside it don't have. The thumb changes its glyph as it
+/// moves by half a cell (`▄`, `█`), so on the first step of a scroll, before
+/// any region has kept the column out, its edges often match nothing and
+/// the track showed nothing either way: the thumb slid with the text. A
+/// margin is the same cell as its neighbours, and text isn't a background
+/// alone (a line prefix, a code block's gutter repeat down the rows too),
+/// so neither is a bar.
+fn isBar(grid: CellGrid, rows: MovedRows, x: usize) bool {
+    const height = rows.reach_bottom - rows.reach_top + 1;
+    if (height < 4) return false;
+    // The cell most of the column has (a majority vote), then a count.
+    var candidate: u64 = blank_cell;
+    var votes: usize = 0;
+    for (rows.reach_top..rows.reach_bottom + 1) |y| {
+        const cell = grid.at(x, y);
+        if (votes == 0) candidate = cell;
+        votes = if (cell == candidate) votes + 1 else votes - 1;
+    }
+    if (candidate == blank_cell or hasText(candidate)) return false;
+    var same: usize = 0;
+    var beside: usize = 0;
+    for (rows.reach_top..rows.reach_bottom + 1) |y| {
+        if (grid.at(x, y) == candidate) same += 1;
+        if (x > 0 and grid.at(x - 1, y) == candidate) beside += 1;
+        if (x + 1 < grid.cols and grid.at(x + 1, y) == candidate) beside += 1;
+    }
+    return same + 2 >= height and beside <= 2;
+}
