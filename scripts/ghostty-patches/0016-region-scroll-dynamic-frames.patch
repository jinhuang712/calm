+            // Not drawn yet: its first frame is due.
+            const tick = self.region_anim_tick orelse return 0;
+            const now: std.Io.Timestamp = .now(global.io(), .awake);
+            const since: f64 = @as(f64, @floatFromInt(@max(tick.durationTo(now).nanoseconds, 0))) /
+                std.time.ns_per_s;
+            return soonest - since;
+        }
