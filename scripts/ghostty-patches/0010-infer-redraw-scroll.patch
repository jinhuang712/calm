+        /// A scroll a program drew by repainting rows instead of scrolling
+        /// them (see `inferScroll`), found by comparing this frame's row
+        /// hashes with the previous frame's; `look` is false when the
+        /// terminal recorded scrolls of its own this frame. Alternate
+        /// screen only, like the scrolls the terminal records. Keeps this
+        /// frame's hashes for the next. Requires the renderer state mutex,
+        /// after the update and its styles (`endUpdate`).
+        fn inferRedrawScroll(self: *Self, look: bool) ?terminal.Screen.RegionScroll {
+            const state = &self.terminal_state;
+            if (state.screen != .alternate) {
+                self.row_hashes.clearRetainingCapacity();
+                self.last_inferred = null;
+                return null;
+            }
 
+            self.row_hashes_next.clearRetainingCapacity();
+            const rows = state.row_data.items(.cells);
+            for (0..state.rows) |y| {
+                const index = state.viewportStart() + y;
+                const hash = if (index < rows.len) rowHash(rows[index].slice()) else blank_row;
+                self.row_hashes_next.append(self.alloc, hash) catch {
+                    self.row_hashes.clearRetainingCapacity();
+                    return null;
+                };
+            }
+            defer {
+                std.mem.swap(std.ArrayListUnmanaged(u64), &self.row_hashes, &self.row_hashes_next);
+                self.row_hashes_cols = state.cols;
+            }
+
+            if (!look or self.row_hashes_cols != state.cols) return null;
+            var scroll = inferScroll(
+                self.row_hashes.items,
+                self.row_hashes_next.items,
+                state.cols,
+            ) orelse return null;
+            if (self.last_inferred) |last| {
+                const near = @max(scroll.top, last.top) - @min(scroll.top, last.top) <= 2 and
+                    @max(scroll.bottom, last.bottom) - @min(scroll.bottom, last.bottom) <= 2;
+                const height: u32 = @as(u32, last.bottom - last.top) + 1;
+                if (near and @abs(scroll.lines) < height) {
+                    scroll.top = last.top;
+                    scroll.bottom = last.bottom;
+                }
+            }
+            self.last_inferred = scroll;
+            return scroll;
+        }
