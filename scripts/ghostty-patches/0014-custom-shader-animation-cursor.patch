+
+test "shaderAnimates: cursor animates for a second after the cursor or the focus changes" {
+    const testing = std.testing;
+    try testing.expect(shaderAnimates(.cursor, true, 0));
+    try testing.expect(shaderAnimates(.cursor, true, cursor_animation_ms - 1));
+    try testing.expect(!shaderAnimates(.cursor, true, cursor_animation_ms));
+    try testing.expect(!shaderAnimates(.cursor, true, 60_000));
+    // Nothing has changed yet, or the terminal isn't focused.
+    try testing.expect(!shaderAnimates(.cursor, true, null));
+    try testing.expect(!shaderAnimates(.cursor, false, 0));
+}
+
+test "shaderAnimates: the other modes don't look at the cursor" {
+    const testing = std.testing;
+    try testing.expect(shaderAnimates(.true, true, null));
+    try testing.expect(shaderAnimates(.true, true, 60_000));
+    try testing.expect(!shaderAnimates(.true, false, 0));
+    try testing.expect(shaderAnimates(.always, false, null));
+    try testing.expect(!shaderAnimates(.false, true, 0));
+}
