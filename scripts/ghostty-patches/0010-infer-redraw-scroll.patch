+/// A hash of what a row shows: each drawn cell's column, character and
+/// style. `blank_row` for a row with nothing drawn in it, which matches any
+/// other empty row and so proves nothing. Styles must be denormalized
+/// (after `endUpdate`).
+fn rowHash(cells: std.MultiArrayList(terminal.RenderState.Cell).Slice) u64 {
+    const raws = cells.items(.raw);
+    const styles = cells.items(.style);
+    var hasher = std.hash.Wyhash.init(0);
+    var drawn = false;
+    for (raws, 0..) |raw, x| {
+        const styled = raw.hasStyling();
+        const text = raw.hasText() and raw.codepoint() != ' ';
+        if (!text and !(styled and styles[x].bg_color != .none)) continue;
+        drawn = true;
+        const column: u32 = @intCast(x);
+        const cp: u32 = raw.codepoint();
+        const style: u64 = if (styled) styles[x].hash() else 0;
+        hasher.update(std.mem.asBytes(&column));
+        hasher.update(std.mem.asBytes(&cp));
+        hasher.update(std.mem.asBytes(&style));
+    }
+    if (!drawn) return blank_row;
+    const hash = hasher.final();
+    return if (hash == blank_row) 1 else hash;
+}
+
+const blank_row: u64 = 0;
+
+/// The fewest rows that must be seen moving before a redraw counts as a
+/// scroll: a couple of rows lining up by chance is not motion.
+const min_moved_rows = 3;
+
+/// The part of a program's redrawn screen that is the previous frame moved
+/// by whole rows, as a region scroll to animate. Many full-screen programs
+/// move their content by repainting every row rather than scrolling it (pi's
+/// full-screen view does, for each streamed line and each wheel step), which
+/// leaves the terminal no scroll to animate; comparing each row with the
+/// frame before finds the motion anyway. `old` and `new` are the rows'
+/// hashes (`rowHash`) before and after.
+///
+/// The shift is the one that explains the most rows that changed and hold
+/// something, and it must explain at least half of them. The region is the
+/// span of rows it explains, widened by the rows it brought in, within one
+/// stretch of the screen that no unchanged row interrupts, so a header or a
+/// prompt drawn the same in both frames stays out of it.
+fn inferScroll(old: []const u64, new: []const u64, cols: usize) ?terminal.Screen.RegionScroll {
+    const n = new.len;
+    if (old.len != n or n < min_moved_rows + 1 or cols == 0) return null;
 
+    var changed: usize = 0;
+    for (old, new) |before, after| {
+        if (after != before and after != blank_row) changed += 1;
+    }
+    if (changed < min_moved_rows) return null;
+
+    const Moved = struct {
+        fn is(o: []const u64, w: []const u64, y: usize, k: isize) bool {
+            const source = @as(isize, @intCast(y)) + k;
+            if (source < 0 or source >= w.len) return false;
+            return w[y] != o[y] and w[y] != blank_row and w[y] == o[@intCast(source)];
+        }
+    };
+
+    // Content moved up by `k` rows means row y now shows old row y + k.
+    const max_k: isize = @intCast(n / 2);
+    var best_k: isize = 0;
+    var best: usize = 0;
+    var k: isize = -max_k;
+    while (k <= max_k) : (k += 1) {
+        if (k == 0) continue;
+        var moved: usize = 0;
+        for (0..n) |y| {
+            if (Moved.is(old, new, y, k)) moved += 1;
+        }
+        if (moved > best or (moved == best and moved > 0 and @abs(k) < @abs(best_k))) {
+            best = moved;
+            best_k = k;
+        }
+    }
+    if (best < min_moved_rows or best * 2 < changed) return null;
+
+    // The stretch between unchanged rows with the most moved rows in it.
+    const Span = struct { start: usize, end: usize, first: usize, last: usize, moved: usize };
+    var span: ?Span = null;
+    var start: usize = 0;
+    while (start < n) {
+        var end = start;
+        var first: ?usize = null;
+        var last: usize = 0;
+        var moved: usize = 0;
+        while (end < n and !(new[end] == old[end] and new[end] != blank_row)) : (end += 1) {
+            if (Moved.is(old, new, end, best_k)) {
+                if (first == null) first = end;
+                last = end;
+                moved += 1;
+            }
+        }
+        if (first) |f| {
+            if (span == null or moved > span.?.moved) span = .{
+                .start = start,
+                .end = end,
+                .first = f,
+                .last = last,
+                .moved = moved,
+            };
+        }
+        start = end + 1;
+    }
+    const found = span orelse return null;
+    if (found.moved < min_moved_rows) return null;
+
+    // Widen by the rows the scroll brought in, which match nothing: below
+    // the moved rows when content went up, above them when it went down,
+    // never past the stretch.
+    const lines: usize = @intCast(@abs(best_k));
+    const top = if (best_k > 0) found.first else @max(found.first -| lines, found.start);
+    const bottom = if (best_k > 0) @min(found.last + lines, found.end - 1) else found.last;
+    if (bottom <= top or lines >= bottom - top + 1) return null;
+    return .{
+        .top = @intCast(top),
+        .bottom = @intCast(bottom),
+        .left = 0,
+        .right = @intCast(cols - 1),
+        .lines = @intCast(best_k),
+    };
+}
