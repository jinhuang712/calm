+        /// Half a refresh: a region frame due that soon is drawn now, so a
+        /// frame due at a vsync isn't missed for a clock read a little early.
+        const region_anim_slack_s: f64 = 0.004;
+
+        /// Seconds from now until a region scroll animation next needs a
+        /// frame (it has moved `region_anim_step_px` since the last drawn
+        /// one, or comes to rest), 0 or less when due; null without one.
+        fn regionAnimDueIn(self: *const Self) ?f64 {
+            if (self.region_anims.items.len == 0) return null;
+            var soonest = std.math.inf(f64);
+            for (self.region_anims.items) |*anim| {
+                soonest = @min(soonest, regionAnimStepSeconds(anim.shift, region_anim_tau_s));
