+
+const test_cols = 60;
+const test_hint = " Jump to bottom (click) v ";
+const test_hint_x = 30;
+
+/// A row of `test_cols` cells holding `text` from column 0, and, when
+/// `hint` is set, a hint drawn over it at `test_hint_x` in a styled box.
+fn testPinnedRow(text: []const u8, hint: bool) [test_cols]terminal.RenderState.Cell {
+    var row: [test_cols]terminal.RenderState.Cell = undefined;
+    for (&row, 0..) |*cell, x| {
+        const in_hint = hint and x >= test_hint_x and x < test_hint_x + test_hint.len;
+        const cp: u21 = if (in_hint)
+            test_hint[x - test_hint_x]
+        else if (x < text.len)
+            text[x]
+        else
+            ' ';
+        var raw = terminal.page.Cell.init(cp);
+        var style: terminal.Style = .{};
+        if (in_hint) {
+            raw.style_id = 1;
+            style = .{ .bg_color = .{ .rgb = .{ .r = 55, .g = 55, .b = 55 } } };
+        }
+        cell.* = .{ .raw = raw, .grapheme = &.{}, .style = style };
+    }
+    return row;
+}
+
+test "repaintedInPlace: a hint drawn again on a scrolled row stays in place" {
+    const testing = std.testing;
+    // Claude Code scrolling back: the region moved down a row, so its last
+    // row now holds what the row above had, and the hint was drawn over it
+    // again where it was.
+    const old = testPinnedRow("  123", true);
+    const source = testPinnedRow("  122", false);
+    const new = testPinnedRow("  122", true);
+    try testing.expect(repaintedInPlace(&new, &old, &source));
+
+    // Scrolling forward, the row is the one entering: no source.
+    const entering = testPinnedRow("  124", true);
+    try testing.expect(repaintedInPlace(&entering, &old, &testPinnedRow("", false)));
+}
+
+test "repaintedInPlace: a hint over a full line of text still counts" {
+    const testing = std.testing;
+    const old = testPinnedRow("The renderer draws the grid shifted by a few pixels.", true);
+    const new = testPinnedRow("Another line of prose runs under the hint as it streams", true);
+    try testing.expect(repaintedInPlace(&new, &old, &testPinnedRow("", false)));
+}
+
+test "repaintedInPlace: scrolled and new content are not in place" {
+    const testing = std.testing;
+    const blank = testPinnedRow("", false);
+
+    // Streaming: the top row now holds what the row below it had.
+    const top_old = testPinnedRow("first line of the answer", false);
+    const top_new = testPinnedRow("second line of the answer", false);
+    try testing.expect(!repaintedInPlace(&top_new, &top_old, &top_new));
+
+    // A new line entering where the last one was: words line up only in
+    // short stretches.
+    const bottom_old = testPinnedRow("alpha beta gamma delta epsilon", false);
+    const bottom_new = testPinnedRow("alpha zeta omega sigma epsilons", false);
+    try testing.expect(!repaintedInPlace(&bottom_new, &bottom_old, &blank));
+
+    // A row identical to the one it scrolled from (a table's border) moved.
+    const border = testPinnedRow("+----------+----------+", false);
+    try testing.expect(!repaintedInPlace(&border, &border, &border));
+
+    // Nothing but spaces is nothing to pin.
+    try testing.expect(!repaintedInPlace(&blank, &blank, &blank));
+}
+
+test "PinnedEdges: the rows that move leave the pinned ones out" {
+    const testing = std.testing;
+    const scroll: terminal.Screen.RegionScroll = .{ .top = 1, .bottom = 29, .left = 0, .right = 99, .lines = -1 };
+    const bottom = (PinnedEdges{ .bottom = true }).moving(scroll).?;
+    try testing.expectEqual(1, bottom.top);
+    try testing.expectEqual(28, bottom.bottom);
+    const both = (PinnedEdges{ .top = true, .bottom = true }).moving(scroll).?;
+    try testing.expectEqual(2, both.top);
+    try testing.expectEqual(28, both.bottom);
+    try testing.expectEqual(scroll, (PinnedEdges{}).moving(scroll).?);
+
+    // Nothing left that keeps content across the scroll is no motion.
+    const small: terminal.Screen.RegionScroll = .{ .top = 3, .bottom = 4, .left = 0, .right = 9, .lines = 1 };
+    try testing.expectEqual(null, (PinnedEdges{ .bottom = true }).moving(small));
+}
