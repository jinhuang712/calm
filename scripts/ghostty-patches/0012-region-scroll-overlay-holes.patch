+test "RenderState RegionShifts leave a hole where it is drawn" {
+    const testing = std.testing;
+
+    // Rows 2..9 of a grid of 10x20px cells drawn 25px below their place,
+    // with the hint on the bottom row's columns 3..5 repainted in place.
+    var shifts: RenderState.RegionShifts = .{};
+    shifts.append(.{
+        .top = 2,
+        .bottom = 9,
+        .left = 0,
+        .right = 9,
+        .offset = 25,
+        .holes = .{ null, .{ .row = 9, .left = 3, .right = 5 } },
+    });
+
+    // The hole's cells are where they are drawn; the rest of their row
+    // slides with the region.
+    try testing.expectEqual(190, shifts.contentY(40, 190, 10, 20));
+    try testing.expectEqual(0, shifts.offsetAt(3, 9));
+    try testing.expectEqual(0, shifts.offsetAt(5, 9));
+    try testing.expectEqual(165, shifts.contentY(20, 190, 10, 20));
+    try testing.expectEqual(165, shifts.contentY(60, 190, 10, 20));
+    try testing.expectEqual(25, shifts.offsetAt(2, 9));
+    try testing.expectEqual(25, shifts.offsetAt(6, 9));
+
+    // Other rows have no hole in those columns.
+    try testing.expectEqual(145, shifts.contentY(40, 170, 10, 20));
+    try testing.expectEqual(25, shifts.offsetAt(4, 8));
