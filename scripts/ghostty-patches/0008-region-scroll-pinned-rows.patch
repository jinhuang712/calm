+/// Feeds `steps` scrolls of the region rows 2–8 (of 12) to a terminal the way
+/// Claude Code scrolls its transcript, `lines` rows each (negative: back),
+/// drawing the hint again on the region's last row after each when `hint`,
+/// and checks what `EdgeRows` makes of every step. Every line's bar runs on
+/// under the hint, the case that once kept the hint from counting.
+fn testEdgeRowsScrolling(lines: i32, steps: usize, hint: bool, expect_bottom: bool) !void {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try terminal.Terminal.init(testing.io, alloc, .{ .cols = 60, .rows = 12 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    var buf: [256]u8 = undefined;
+
+    const hint_seq = "\x1b[8;31H\x1b[48;2;255;0;255m\x1b[38;2;255;255;255m Jump to bottom (click) \x1b[0m";
+    s.nextSlice("\x1b[?1049h\x1b[H\x1b[2J");
+    var line: usize = 0;
+    for (2..9) |row| {
+        s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};1H\x1b[2Kline {:0>3} ################################################", .{ row, line }));
+        line += 1;
+    }
+    if (hint) s.nextSlice(hint_seq);
+
+    var state: terminal.RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+    t.screens.active.region_scrolls.clear();
+
+    var edges: EdgeRows = .{};
+    defer edges.deinit(alloc);
+    const count: usize = @intCast(@abs(lines));
+    for (0..steps) |_| {
+        if (lines > 0) {
+            s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[2;8r\x1b[{}S\x1b[r", .{count}));
+            for (9 - count..9) |row| {
+                s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};1H\x1b[2Kline {:0>3} ################################################", .{ row, line }));
+                line += 1;
+            }
+            // The old hint scrolled up with the rest; clear it.
+            if (hint) s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};31H\x1b[K", .{8 - count}));
+        } else {
+            s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[2;8r\x1b[{}T\x1b[r", .{count}));
+            for (2..2 + count) |row| {
+                s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};1H\x1b[2Kline {:0>3} ################################################", .{ row, line }));
+                line += 1;
+            }
+        }
+        if (hint) s.nextSlice(hint_seq);
+
+        // The renderer's order: snapshot, update, compare.
+        const scrolls = t.screens.active.region_scrolls.slice();
+        try testing.expectEqual(1, scrolls.len);
+        edges.snapshot(alloc, &state, scrolls);
+        try state.update(alloc, &t);
+        const pinned = edges.pinned(alloc, &state, scrolls[0], 0);
+        try testing.expectEqual(expect_bottom, pinned.bottom);
+        try testing.expect(!pinned.top);
+        t.screens.active.region_scrolls.clear();
+    }
+}
+
+test "EdgeRows: a hint drawn again after every scroll back is pinned" {
+    try testEdgeRowsScrolling(-2, 10, true, true);
+    try testEdgeRowsScrolling(-1, 10, true, true);
+}
+
+test "EdgeRows: a hint drawn again after every scroll forward is pinned" {
+    try testEdgeRowsScrolling(2, 10, true, true);
+}
+
+test "EdgeRows: plain scrolling pins nothing" {
+    try testEdgeRowsScrolling(3, 10, false, false);
+    try testEdgeRowsScrolling(-3, 10, false, false);
+}
