+    }
+    return .{
+        .top = @intCast(rows.top),
+        .bottom = @intCast(rows.bottom),
+        .left = @intCast(columns.left),
+        .right = @intCast(columns.right),
+        .lines = @intCast(rows.lines),
+    };
+}
