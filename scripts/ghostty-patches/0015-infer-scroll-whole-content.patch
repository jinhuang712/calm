+/// The innermost still column at one side of the screen (see
+/// `movingColumns`), if any; `kept` is the one the last region kept out.
+fn stillEdge(old: CellGrid, new: CellGrid, rows: MovedRows, side: enum { left, right }, kept: ?usize) ?usize {
+    const cols = new.cols;
+    var found: ?usize = null;
+    // Columns since the side or the last still column: a scrollbar sits at
+    // the edge of what scrolls, which a sidebar can put far from the screen's.
+    var since: usize = 0;
+    for (0..cols) |i| {
+        const x = if (side == .right) cols - 1 - i else i;
+        const seen = columnMotion(old, new, rows, x);
+        if (seen.moved > 0 and seen.moved >= seen.stayed) break;
+        if (seen.stayed > 0 or kept == x or (since < still_edge_band and isBar(new, rows, x))) {
+            found = x;
+            since = 0;
+        } else since += 1;
+    }
+    return found;
