+test "joinInferred: a region near the last one takes the rows of both" {
+    const testing = std.testing;
+    const last: terminal.Screen.RegionScroll = .{ .top = 0, .bottom = 25, .left = 0, .right = 96, .lines = -3 };
+
+    // A row more, and the scrollbar found: both kept.
+    const more = joinInferred(last, .{ .top = 0, .bottom = 26, .left = 0, .right = 93, .lines = -3 }).?;
+    try testing.expectEqual(0, more.top);
+    try testing.expectEqual(26, more.bottom);
+    try testing.expectEqual(93, more.right);
+
+    // A row fewer this time: the last region's row stays in.
+    const fewer = joinInferred(more, .{ .top = 1, .bottom = 26, .left = 0, .right = 93, .lines = -1 }).?;
+    try testing.expectEqual(0, fewer.top);
+    try testing.expectEqual(26, fewer.bottom);
+    try testing.expectEqual(-1, fewer.lines);
+
+    // Somewhere else, or a jump past its height: a region of its own.
+    try testing.expectEqual(null, joinInferred(last, .{ .top = 10, .bottom = 25, .left = 0, .right = 96, .lines = 2 }));
+    try testing.expectEqual(null, joinInferred(last, .{ .top = 0, .bottom = 25, .left = 0, .right = 96, .lines = 30 }));
+}
