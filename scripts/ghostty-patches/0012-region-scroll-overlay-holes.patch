+/// A row that scrolled out of a region, as a ghost draws it: the previous
+/// frame's cells `bg` and `fg` less the overlay's `columns`. What the program
+/// repaints in place is not content that scrolled away; a ghost of it slides
+/// around the region as a second copy of the hint, wherever the ghost is by
+/// the time a later scroll (the renderer often takes several in a frame, all
+/// making their ghosts from the frame before) has moved it.
+fn ghostCells(
+    comptime Bg: type,
+    comptime Text: type,
+    alloc: Allocator,
+    bg: []const Bg,
+    fg: []const Text,
+    columns: ?Overlays.Columns,
+) Allocator.Error!struct { bg: []Bg, fg: []Text } {
+    const bg_copy = try alloc.dupe(Bg, bg);
+    errdefer alloc.free(bg_copy);
+    const overlay = columns orelse return .{
+        .bg = bg_copy,
+        .fg = try alloc.dupe(Text, fg),
+    };
+
+    const from = @min(overlay.left, bg_copy.len);
+    const to = @min(@as(usize, overlay.right) + 1, bg_copy.len);
+    @memset(bg_copy[from..to], std.mem.zeroes(Bg));
+    var kept = try std.ArrayListUnmanaged(Text).initCapacity(alloc, fg.len);
+    errdefer kept.deinit(alloc);
+    for (fg) |cell| {
+        if (cell.grid_pos[0] >= overlay.left and cell.grid_pos[0] <= overlay.right) continue;
+        kept.appendAssumeCapacity(cell);
+    }
+    return .{ .bg = bg_copy, .fg = try kept.toOwnedSlice(alloc) };
+}
+
+/// Where the text an overlay hides comes from. The overlay is drawn over
+/// the cells of its edge row, so the terminal holds nothing there: the row
+/// that slides into the overlay's place would carry a blank the size of the
+/// overlay until it arrives. But when the region scrolled back (down), the
+/// new bottom row was `net` rows higher in the frame before, where no overlay
+/// covered it, and the same goes for a top overlay when it scrolled forward.
+/// A ghost row made of those cells, drawn with the content, fills the blank.
+/// `net` is what the frame's scrolls of the region add up to.
+const OverlayFill = struct {
+    /// The row of the previous frame the text is in.
+    source: usize,
+    /// The row it slides into.
+    row: usize,
+    columns: Overlays.Columns,
+};
+
+fn overlayFills(
+    overlays: Overlays,
+    scroll: terminal.Screen.RegionScroll,
+    net: i32,
+) [2]?OverlayFill {
+    const height: u32 = @as(u32, scroll.bottom - scroll.top) + 1;
+    const moved: u32 = @abs(net);
+    var fills: [2]?OverlayFill = .{ null, null };
+    if (moved == 0 or moved >= height) return fills;
+    if (overlays.bottom) |columns| if (net < 0) {
+        fills[0] = .{ .source = scroll.bottom - moved, .row = scroll.bottom, .columns = columns };
+    };
+    if (overlays.top) |columns| if (net > 0) {
+        fills[1] = .{ .source = scroll.top + moved, .row = scroll.top, .columns = columns };
+    };
+    return fills;
+}
+
+/// A ghost row holding only the cells in `columns` of the row `bg` and `fg`
+/// are from: the text an overlay hides (see `OverlayFill`).
+fn columnCells(
+    comptime Bg: type,
+    comptime Text: type,
+    alloc: Allocator,
+    bg: []const Bg,
+    fg: []const Text,
+    columns: Overlays.Columns,
+) Allocator.Error!struct { bg: []Bg, fg: []Text } {
+    const bg_copy = try alloc.alloc(Bg, bg.len);
+    errdefer alloc.free(bg_copy);
+    @memset(bg_copy, std.mem.zeroes(Bg));
+    const from = @min(columns.left, bg.len);
+    const to = @min(@as(usize, columns.right) + 1, bg.len);
+    @memcpy(bg_copy[from..to], bg[from..to]);
+
+    var kept: std.ArrayListUnmanaged(Text) = .empty;
+    errdefer kept.deinit(alloc);
+    for (fg) |cell| {
+        if (cell.grid_pos[0] < columns.left or cell.grid_pos[0] > columns.right) continue;
+        try kept.append(alloc, cell);
+    }
+    return .{ .bg = bg_copy, .fg = try kept.toOwnedSlice(alloc) };
+}
