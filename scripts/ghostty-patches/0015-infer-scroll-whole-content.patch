+test "inferScroll: text out to the edge moves with its rows" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try terminal.Terminal.init(testing.io, alloc, .{ .cols = 40, .rows = 16 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    var buf: [256]u8 = undefined;
+    var state: terminal.RenderState = .empty;
+    defer state.deinit(alloc);
+
+    // Every row written across the whole width, different on each line.
+    const Frame = struct {
+        fn draw(stream: anytype, b: []u8, first: usize) !void {
+            stream.nextSlice("\x1b[?2026h");
+            for (1..13) |row| stream.nextSlice(try std.fmt.bufPrint(
+                b,
+                "\x1b[{};1H\x1b[2Kline {d:0>3} of the answer, all the way out{c}",
+                .{ row, first + row, @as(u8, 'a' + @as(u8, @intCast((first + row) % 26))) },
+            ));
+            stream.nextSlice("\x1b[15;1H\x1b[2K> type here\x1b[?2026l");
+        }
+    };
+    s.nextSlice("\x1b[?1049h");
+    try Frame.draw(&s, &buf, 0);
+    try state.update(alloc, &t);
+    var old: [16 * 40]u64 = undefined;
+    testCellHashes(&state, 40, &old);
+    try Frame.draw(&s, &buf, 3);
+    try state.update(alloc, &t);
+    var new: [16 * 40]u64 = undefined;
+    testCellHashes(&state, 40, &new);
+    var scratch: [32]u64 = undefined;
+
+    const scroll = inferScroll(.{ .cells = &old, .cols = 40 }, .{ .cells = &new, .cols = 40 }, null, &scratch).?;
+    try testing.expectEqual(3, scroll.lines);
+    try testing.expectEqual(39, scroll.right);
+    // A column the last scroll left out comes back once it's seen moving.
+    const back = inferScroll(.{ .cells = &old, .cols = 40 }, .{ .cells = &new, .cols = 40 }, .{ .left = 0, .right = 36 }, &scratch).?;
+    try testing.expectEqual(39, back.right);
