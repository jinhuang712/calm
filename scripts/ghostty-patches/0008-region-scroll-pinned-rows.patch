Subject: region scroll animation leaves rows repainted in place where they are

smooth-scroll animates a program's region scroll by drawing the region's
content where it was and easing it home, with the rows that scrolled out
sliding away as ghosts. A program that keeps an overlay inside the region,
redrawing it on the same row after every scroll (Claude Code's "Jump to
bottom" hint on its transcript's last row), had that row animated too: the
old copy slid away as a ghost while the new one slid in, so a scroll drew
the hint two or three times. An edge row whose new frame repaints a run of
the cells it had before is now drawn in place, and only the rows between the
pinned ones move.

Calm's own patch (not from thdxg/ghostty); applies on top of 0005.

diff --git a/src/renderer/generic.zig b/src/renderer/generic.zig
--- a/src/renderer/generic.zig
+++ b/src/renderer/generic.zig
@@ -65,6 +65,217 @@
 /// one is taken last everywhere (inside `draw_mutex` by drawFrame, inside
 /// the state mutex by updateFrame and the surface) and nothing is taken
 /// while it is held, so it can't be part of a deadlock.
+/// The edge rows of a scrolled region that the program repainted where
+/// they were instead of letting them scroll: an overlay pinned inside the
+/// region, such as Claude Code's "Jump to bottom" hint on the last row of
+/// its transcript. They are drawn in place, and a region scroll animation
+/// moves only the rows between them (see `repaintedInPlace`). Animating
+/// them with the rest drew the overlay twice, the old copy sliding away as
+/// a ghost row while the new one slid in.
+const PinnedEdges = struct {
+    top: bool = false,
+    bottom: bool = false,
+
+    /// The part of `scroll` that moves: the region without its pinned
+    /// rows. Null when that leaves nothing that keeps any content across
+    /// the scroll, which is then no motion to draw.
+    fn moving(
+        self: PinnedEdges,
+        scroll: terminal.Screen.RegionScroll,
+    ) ?terminal.Screen.RegionScroll {
+        var region = scroll;
+        if (self.top) region.top += 1;
+        if (self.bottom) {
+            if (region.bottom == 0) return null;
+            region.bottom -= 1;
+        }
+        if (region.bottom < region.top) return null;
+        const height: u32 = @as(u32, region.bottom - region.top) + 1;
+        if (@abs(region.lines) >= height) return null;
+        return region;
+    }
+};
+
+/// A region scroll drained from the terminal, with the edge rows the
+/// program repainted in place in the same frame.
+const PendingScroll = struct {
+    scroll: terminal.Screen.RegionScroll,
+    pinned: PinnedEdges = .{},
+};
+
+/// Whether `new`, an edge row of a scrolled region, carries something the
+/// program repainted where it was rather than content the scroll moved: an
+/// overlay, a run of at least `pinned_run` cells with a background color
+/// and some text in it that are what `old`, the row there in the previous
+/// frame, had in the same cells, and mostly not what `source`, the row the
+/// scroll moved into it, had (empty when that row is outside the region).
+/// Such a run can sit over whatever the row holds. Plain text is never an
+/// overlay: consecutive lines often share long runs in the same cells (a
+/// table's rule, indentation, a bar), and the scroll animates them.
+fn repaintedInPlace(
+    new: []const terminal.RenderState.Cell,
+    old: []const terminal.RenderState.Cell,
+    source: []const terminal.RenderState.Cell,
+) bool {
+    var run: usize = 0;
+    var run_text: usize = 0;
+    var run_moved: usize = 0;
+    for (new, 0..) |cell, x| {
+        const boxed = cell.raw.hasStyling() and cell.style.bg_color != .none;
+        if (!boxed or x >= old.len or !sameCell(cell, old[x])) {
+            run = 0;
+            run_text = 0;
+            run_moved = 0;
+            continue;
+        }
+        run += 1;
+        if (cell.raw.hasText() and cell.raw.codepoint() != ' ') run_text += 1;
+        if (x < source.len and sameCell(cell, source[x])) run_moved += 1;
+        if (run >= pinned_run and run_text >= pinned_text and run_moved * 2 < run) return true;
+    }
+    return false;
+}
+
+/// The shortest run that counts as a pinned overlay, and the text it must
+/// hold: shorter than a hint such as Claude Code's " Jump to bottom
+/// (click) ↓ " (25 cells on a grey box), longer than chance, and not a band
+/// of color with nothing in it.
+const pinned_run = 8;
+const pinned_text = 4;
+
+/// Same character and style. The style is only defined on styled cells.
+fn sameCell(a: terminal.RenderState.Cell, b: terminal.RenderState.Cell) bool {
+    if (a.raw.codepoint() != b.raw.codepoint()) return false;
+    if (a.raw.hasStyling() != b.raw.hasStyling()) return false;
+    return !a.raw.hasStyling() or a.style.eql(b.style);
+}
+
+/// The previous frame's rows that decide whether a region scroll left an
+/// edge row repainted in place: `slots` rows of `cols` cells per scroll,
+/// taken before the render state takes the new frame (`snapshot`) and
+/// compared with it after (`pinned`).
+const EdgeRows = struct {
+    cells: std.ArrayListUnmanaged(terminal.RenderState.Cell) = .empty,
+    /// One row of the new frame, to compare.
+    new: std.ArrayListUnmanaged(terminal.RenderState.Cell) = .empty,
+    cols: usize = 0,
+
+    /// Per scroll: its top and bottom rows, and the rows it moves into them.
+    const slots = 4;
+
+    const blank: terminal.RenderState.Cell = .{
+        .raw = terminal.page.Cell.init(0),
+        .grapheme = &.{},
+        .style = .{},
+    };
+
+    fn deinit(self: *EdgeRows, alloc: Allocator) void {
+        self.cells.deinit(alloc);
+        self.new.deinit(alloc);
+    }
+
+    /// The rows of `scroll` kept in each slot, when inside the region: its
+    /// top and bottom rows, then the rows whose content the scroll moves
+    /// into the top and into the bottom (row y shows row y + lines of the
+    /// frame before).
+    fn slotRows(scroll: terminal.Screen.RegionScroll) [slots]?usize {
+        const top: isize = scroll.top;
+        const bottom: isize = scroll.bottom;
+        const into_top = top + scroll.lines;
+        const into_bottom = bottom + scroll.lines;
+        return .{
+            @intCast(top),
+            @intCast(bottom),
+            if (into_top >= top and into_top <= bottom) @intCast(into_top) else null,
+            if (into_bottom >= top and into_bottom <= bottom) @intCast(into_bottom) else null,
+        };
+    }
+
+    /// One row of `state` as cells to compare. The style is read only for a
+    /// styled cell, the one kind it is defined for.
+    fn copyRow(
+        alloc: Allocator,
+        state: *const terminal.RenderState,
+        y: usize,
+        cols: usize,
+        out: *std.ArrayListUnmanaged(terminal.RenderState.Cell),
+    ) Allocator.Error!void {
+        const rows = state.row_data.items(.cells);
+        const index = state.viewportStart() + y;
+        if (y >= state.rows or index >= rows.len) {
+            try out.appendNTimes(alloc, blank, cols);
+            return;
+        }
+        const cells = rows[index].slice();
+        for (0..cols) |x| {
+            if (x >= cells.len) {
+                try out.append(alloc, blank);
+                continue;
+            }
+            const raw = cells.items(.raw)[x];
+            try out.append(alloc, .{
+                .raw = raw,
+                .grapheme = &.{},
+                .style = if (raw.hasStyling()) cells.items(.style)[x] else .{},
+            });
+        }
+    }
+
+    /// Before `old`, the render state of the frame on screen, takes the new
+    /// frame: the rows each of `scrolls` needs, as `old` has them.
+    fn snapshot(
+        self: *EdgeRows,
+        alloc: Allocator,
+        old: *const terminal.RenderState,
+        scrolls: []const terminal.Screen.RegionScroll,
+    ) void {
+        self.cells.clearRetainingCapacity();
+        self.cols = old.cols;
+        if (old.rows == 0 or old.cols == 0) return;
+        for (scrolls) |scroll| for (slotRows(scroll)) |slot| {
+            if (slot) |y| {
+                copyRow(alloc, old, y, old.cols, &self.cells) catch return;
+            } else {
+                self.cells.appendNTimes(alloc, blank, old.cols) catch return;
+            }
+        };
+    }
+
+    /// Which edge rows of the `index`th snapshotted scroll `new`, the render
+    /// state once it has taken the new frame, shows repainted in place.
+    fn pinned(
+        self: *EdgeRows,
+        alloc: Allocator,
+        new: *const terminal.RenderState,
+        scroll: terminal.Screen.RegionScroll,
+        index: usize,
+    ) PinnedEdges {
+        const cols = self.cols;
+        // A new grid size has nothing to compare against.
+        if (cols == 0 or cols != new.cols) return .{};
+        const start = index * slots * cols;
+        if (self.cells.items.len < start + slots * cols) return .{};
+        const kept = self.cells.items[start..][0 .. slots * cols];
+
+        const Edge = struct { y: usize, old: usize, source: usize };
+        const edges = [2]Edge{
+            .{ .y = scroll.top, .old = 0, .source = 2 },
+            .{ .y = scroll.bottom, .old = 1, .source = 3 },
+        };
+        var result: [2]bool = .{ false, false };
+        for (edges, 0..) |edge, i| {
+            self.new.clearRetainingCapacity();
+            copyRow(alloc, new, edge.y, cols, &self.new) catch return .{};
+            result[i] = repaintedInPlace(
+                self.new.items,
+                kept[edge.old * cols ..][0..cols],
+                kept[edge.source * cols ..][0..cols],
+            );
+        }
+        return .{ .top = result[0], .bottom = result[1] };
+    }
+};
