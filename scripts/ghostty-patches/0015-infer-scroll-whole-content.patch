+    const old_rows = scratch[0..n];
+    const new_rows = scratch[n .. 2 * n];
+    var rows = rows: {
+        old.rowHashes(middle, old_rows);
+        new.rowHashes(middle, new_rows);
+        if (inferRows(old_rows, new_rows, .{ .old = old, .new = new, .columns = middle })) |rows| break :rows rows;
+        if (middle.eql(full)) return null;
+        old.rowHashes(full, old_rows);
+        new.rowHashes(full, new_rows);
+        break :rows inferRows(old_rows, new_rows, .{ .old = old, .new = new, .columns = full }) orelse return null;
+    };
