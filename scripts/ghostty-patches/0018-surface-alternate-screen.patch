Subject: ghostty_surface_alternate_screen tells the app which screen is shown

An embedder can't tell a full-screen program's screen (the alternate one,
which keeps no scrollback) from a short normal screen: the scroll bar reads
the same for both. Calm's find needs it to say that only what's on screen
can be searched there. A read of the active screen's key under the
renderer's lock, as ghostty_surface_mouse_captured reads the mouse flags.

Calm's own patch (not from thdxg/ghostty); applies on top of 0017.

diff --git a/include/ghostty.h b/include/ghostty.h
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1206,6 +1206,7 @@
 GHOSTTY_API void ghostty_surface_text(ghostty_surface_t, const char*, uintptr_t);
 GHOSTTY_API void ghostty_surface_preedit(ghostty_surface_t, const char*, uintptr_t);
 GHOSTTY_API bool ghostty_surface_mouse_captured(ghostty_surface_t);
+GHOSTTY_API bool ghostty_surface_alternate_screen(ghostty_surface_t);
 GHOSTTY_API bool ghostty_surface_mouse_button(ghostty_surface_t,
                                                  ghostty_input_mouse_state_e,
                                                  ghostty_input_mouse_button_e,
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2114,6 +2114,13 @@
         return surface.core_surface.mouseCaptured();
     }
 
+    /// Whether the terminal shows its alternate screen, the one a
+    /// full-screen program (an editor, a pager, an agent's full-screen
+    /// view) draws on, which keeps no scrollback.
+    export fn ghostty_surface_alternate_screen(surface: *Surface) bool {
+        return surface.core_surface.alternateScreen();
+    }
+
     /// Tell the surface that it needs to schedule a render
     export fn ghostty_surface_mouse_button(
         surface: *Surface,
diff --git a/src/Surface.zig b/src/Surface.zig
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -3903,6 +3903,13 @@
     return self.io.terminal.flags.mouse_event != .none;
 }
 
+/// Returns true if the alternate screen is the active one.
+pub fn alternateScreen(self: *Surface) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    return self.io.terminal.screens.active_key == .alternate;
+}
+
 /// Called for mouse button press/release events. This will return true
 /// if the mouse event was consumed in some way (i.e. the program is capturing
 /// mouse events). If the event was not consumed, then false is returned.
