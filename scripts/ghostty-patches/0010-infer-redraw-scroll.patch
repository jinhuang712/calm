+
+/// Row hashes for a screen of `n` rows: a header on row 0, content rows
+/// numbered from `first` on rows 1 through `n - 4`, and a three-row prompt
+/// that never changes below them.
+fn testInferScreen(comptime n: usize, first: u64) [n]u64 {
+    var rows: [n]u64 = undefined;
+    rows[0] = 0xAAAA;
+    for (1..n - 3) |y| rows[y] = 1000 + first + y;
+    for (n - 3..n) |y| rows[y] = 0xBBBB + y;
+    return rows;
+}
+
+test "inferScroll: content repainted a few rows higher is a scroll up" {
+    const testing = std.testing;
+    const old = testInferScreen(24, 0);
+    const new = testInferScreen(24, 3);
+    const scroll = inferScroll(&old, &new, 80).?;
+    try testing.expectEqual(3, scroll.lines);
+    // The header and the prompt stay out of it.
+    try testing.expectEqual(1, scroll.top);
+    try testing.expectEqual(20, scroll.bottom);
+    try testing.expectEqual(79, scroll.right);
 }
+
+test "inferScroll: content repainted lower is a scroll down" {
+    const testing = std.testing;
+    const old = testInferScreen(24, 3);
+    const new = testInferScreen(24, 0);
+    const scroll = inferScroll(&old, &new, 80).?;
+    try testing.expectEqual(-3, scroll.lines);
+    try testing.expectEqual(1, scroll.top);
+    try testing.expectEqual(20, scroll.bottom);
+}
+
+test "inferScroll: changes no shift explains are not a scroll" {
+    const testing = std.testing;
+    const old = testInferScreen(24, 0);
+    var new = old;
+    // A progress display rewriting its rows in place.
+    for (2..12) |y| new[y] = 50_000 + y;
+    try testing.expectEqual(null, inferScroll(&old, &new, 80));
+
+    // Nothing changed.
+    try testing.expectEqual(null, inferScroll(&old, &old, 80));
+
+    // Two rows lining up is chance, not motion.
+    var two = old;
+    two[5] = old[6];
+    two[6] = old[7];
+    try testing.expectEqual(null, inferScroll(&old, &two, 80));
+}
+
+test "inferScroll: an unchanged row splits the screen" {
+    const testing = std.testing;
+    // Two panes, rows 1–10 and 12–20, split by a divider on row 11 that
+    // stays; only the lower one scrolled.
+    var old: [24]u64 = undefined;
+    var new: [24]u64 = undefined;
+    for (0..24) |y| old[y] = 7000 + y;
+    new = old;
+    for (12..21) |y| old[y] = 9000 + y;
+    for (12..21) |y| new[y] = 9000 + y + 2;
+    const scroll = inferScroll(&old, &new, 80).?;
+    try testing.expectEqual(2, scroll.lines);
+    try testing.expectEqual(12, scroll.top);
+    try testing.expectEqual(20, scroll.bottom);
+}
+
+/// The hashes of `state`'s viewport rows, as the renderer takes them.
+fn testRowHashes(state: *const terminal.RenderState, out: []u64) void {
+    const rows = state.row_data.items(.cells);
+    for (out, 0..) |*hash, y| hash.* = rowHash(rows[state.viewportStart() + y].slice());
+}
+
+test "inferScroll: a program repainting every row finds its scroll" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try terminal.Terminal.init(testing.io, alloc, .{ .cols = 50, .rows = 16 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    var buf: [128]u8 = undefined;
+
+    // Draws a transcript from `first` on rows 2–12 the way pi's
+    // full-screen view does: every row rewritten in place, in one
+    // synchronized update, under a header and above a prompt that stay.
+    const Frame = struct {
+        fn draw(stream: anytype, b: []u8, first: usize) !void {
+            stream.nextSlice("\x1b[?2026h\x1b[1;1H\x1b[2K\x1b[1mpi\x1b[0m");
+            for (2..13) |row| stream.nextSlice(try std.fmt.bufPrint(
+                b,
+                "\x1b[{};1H\x1b[2Kline {} of the answer",
+                .{ row, first + row },
+            ));
+            stream.nextSlice("\x1b[15;1H\x1b[2K> type here\x1b[?2026l");
+        }
+    };
+
+    s.nextSlice("\x1b[?1049h");
+    try Frame.draw(&s, &buf, 0);
+    var state: terminal.RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+    var old: [16]u64 = undefined;
+    testRowHashes(&state, &old);
+
+    // The answer streamed two lines: everything moved up two rows.
+    try Frame.draw(&s, &buf, 2);
+    try state.update(alloc, &t);
+    var new: [16]u64 = undefined;
+    testRowHashes(&state, &new);
+    const scroll = inferScroll(&old, &new, 50).?;
+    try testing.expectEqual(2, scroll.lines);
+    try testing.expectEqual(1, scroll.top);
+    try testing.expectEqual(11, scroll.bottom);
+
+    // Drawn again unchanged: no motion.
+    try Frame.draw(&s, &buf, 2);
+    try state.update(alloc, &t);
+    var same: [16]u64 = undefined;
+    testRowHashes(&state, &same);
+    try testing.expectEqual(null, inferScroll(&new, &same, 50));
+}
