+/// How many of column `x`'s edges within the reach of `rows` moved with
+/// them and how many stayed (see `movingColumns`).
+fn columnMotion(old: CellGrid, new: CellGrid, rows: MovedRows, x: usize) struct { moved: usize, stayed: usize } {
+    const Edge = struct {
+        /// Whether `grid`'s column `x` turns from `above` to `here` at row
+        /// `y`, both rows within the reach of `rows`.
+        fn at(grid: CellGrid, column: usize, y: isize, within: MovedRows, above: u64, here: u64) bool {
+            if (y <= @as(isize, @intCast(within.reach_top)) or y > @as(isize, @intCast(within.reach_bottom))) return false;
+            const row: usize = @intCast(y);
+            return grid.at(column, row - 1) == above and grid.at(column, row) == here;
+        }
+    };
+    var moved: usize = 0;
+    var stayed: usize = 0;
+    for (rows.reach_top + 1..rows.reach_bottom + 1) |y| {
+        const above = new.at(x, y - 1);
+        const here = new.at(x, y);
+        if (above == here) continue;
+        const row: isize = @intCast(y);
+        const source = row + rows.lines;
+        if (source <= @as(isize, @intCast(rows.reach_top)) or source > @as(isize, @intCast(rows.reach_bottom))) {
+            // Brought in: it can't have moved, but it can stand exactly
+            // where it was, as a panel beside the rows does.
+            if (Edge.at(old, x, row, rows, above, here)) stayed += 1;
+            continue;
+        }
+        if (Edge.at(old, x, source, rows, above, here)) {
+            moved += 1;
+            continue;
+        }
+        for ([_]isize{ 0, -1, 1, -2, 2 }) |d| {
+            if (d == rows.lines) continue;
+            if (Edge.at(old, x, row + d, rows, above, here)) {
+                stayed += 1;
+                break;
+            }
+        }
+    }
+    return .{ .moved = moved, .stayed = stayed };
+}
