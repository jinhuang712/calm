+
+test "regionAnimStepSeconds: a pixel's move, soon while fast, later as it slows" {
+    const testing = std.testing;
+    const tau = 0.045;
+    // 102 px left moves a pixel in well under a refresh.
+    try testing.expect(regionAnimStepSeconds(102, tau) < 0.001);
+    // 5 px left: tau * ln(5 / 4), about 10 ms.
+    try testing.expectApproxEqAbs(tau * @log(5.0 / 4.0), regionAnimStepSeconds(5, tau), 1e-12);
+    // Under 1.5 px left the next frame is the one it comes to rest in.
+    try testing.expectApproxEqAbs(tau * @log(1.2 / 0.499), regionAnimStepSeconds(1.2, tau), 1e-12);
+    // Scrolling back (a negative shift) the same; at rest, nothing to wait for.
+    try testing.expectEqual(regionAnimStepSeconds(5, tau), regionAnimStepSeconds(-5, tau));
+    try testing.expectEqual(@as(f64, 0), regionAnimStepSeconds(0.3, tau));
+}
+
+test "regionAnimStepSeconds: a 3-row scroll draws a quarter to a half fewer frames" {
+    const testing = std.testing;
+    const tau = 0.045;
+    const vsync = 1.0 / 120.0;
+    // Today: a frame at every refresh until it comes to rest.
+    var every: u32 = 0;
+    var s: f64 = 102;
+    while (@abs(s) >= 0.5) : (every += 1) s *= @exp(-vsync / tau);
+    // Now: a refresh draws only when a frame is due, within half a refresh.
+    var shift: f64 = 102;
+    var last: f64 = 0;
+    var t: f64 = 0;
+    var drawn: u32 = 0;
+    while (true) {
+        t += vsync;
+        if (regionAnimStepSeconds(shift, tau) - (t - last) > 0.004) continue;
+        shift *= @exp(-(t - last) / tau);
+        last = t;
+        drawn += 1;
+        if (@abs(shift) < 0.5) break;
+    }
+    try testing.expect(drawn * 4 <= every * 3);
+    try testing.expect(drawn * 2 >= every);
+    // It comes to rest when it did before, within two refreshes.
+    try testing.expect(@abs(t - @as(f64, @floatFromInt(every)) * vsync) <= 2 * vsync);
+}
